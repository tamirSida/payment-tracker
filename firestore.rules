rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validPayment(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.priceCents is int && d.priceCents > 0 && d.priceCents <= 10000000000
        && d.currency in ['USD', 'EUR', 'ILS']
        && isDate(d.startDate)
        && (d.endDate == null || isDate(d.endDate))
        && d.schedule is map
        && d.schedule.type in ['daily', 'weekly', 'monthly']
        && d.schedule.every is int && d.schedule.every >= 1
        && d.schedule.weekdays is list
        && d.schedule.dayOfMonth is int
        && d.multiN is int && d.multiN >= 1
        && d.createdAt is int;
    }

    function validTransaction(d) {
      return d.paymentId is string
        && d.amountCents is int && d.amountCents > 0 && d.amountCents <= 10000000000
        && d.note is string && d.note.size() <= 120
        && isDate(d.date)
        && d.createdAt is int;
    }

    // Tally data: each signed-in user can only access their own subtree.
    match /tally_users/{uid}/payments/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validPayment(request.resource.data);
    }

    match /tally_users/{uid}/transactions/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validTransaction(request.resource.data);
    }
  }
}
